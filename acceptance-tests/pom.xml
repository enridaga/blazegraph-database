<?xml version="1.0" encoding="UTF-8"?>
<!--
  Blazegraph compatibility acceptance tests.

  This is a standalone Maven project: it is NOT a module of the Blazegraph
  reactor and does not inherit from its parent POM. It exercises an already
  built Blazegraph executable jar (property "blazegraph.jar") in two ways:

   * black-box over HTTP, by launching the jar in a separate JVM;
   * through the public Java APIs (embedded journal, embedded server,
     remote client), compiled and run against that same jar.

  See README.md for the list of tests and how to run them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.blazegraph.acceptance</groupId>
  <artifactId>blazegraph-acceptance-tests</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Blazegraph Compatibility Acceptance Tests</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Blazegraph build under test -->
    <blazegraph.version>2.1.6-SNAPSHOT</blazegraph.version>
    <blazegraph.jar>${project.basedir}/../blazegraph-jar/target/blazegraph-jar-${blazegraph.version}.jar</blazegraph.jar>
    <!-- JVM used to run the server under test (empty: the JVM running the tests) -->
    <blazegraph.java></blazegraph.java>

    <junit.version>5.14.4</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Public Java APIs under test. The executable jar is a self-contained
      distribution (Blazegraph, its dependencies, jetty.xml and the web
      application), so the Java API tests use exactly the artifact that the
      HTTP tests launch. No other library is added to the test classpath, to
      avoid shadowing classes bundled in that jar.
    -->
    <dependency>
      <groupId>com.blazegraph</groupId>
      <artifactId>blazegraph-jar</artifactId>
      <version>${blazegraph.version}</version>
      <scope>system</scope>
      <systemPath>${blazegraph.jar}</systemPath>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <trimStackTrace>false</trimStackTrace>
          <argLine>-Xmx2g</argLine>
          <systemPropertyVariables>
            <blazegraph.jar>${blazegraph.jar}</blazegraph.jar>
            <blazegraph.java>${blazegraph.java}</blazegraph.java>
            <blazegraph.workdir>${project.build.directory}/work</blazegraph.workdir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
